GR_ROOT=D:/LLM_Project_data/GRs
CACHE_DIR=D:/LLM_Project_data/.cache_local
DATABASE_URL=postgresql://gr_user:gr_password@127.0.0.1:5434/grdb
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024
TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe
OCR_LANG=mar+eng
OCR_DPI=300
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
EMBED_BATCH_SIZE=8
KG_REVIEW_MODE=auto
RETRIEVAL_MODE=dense
KG_AUTO_INGEST_RESOLVED=false
EXTERNAL_INCOMING_ROOT=D:/LLM_Project_data/Government_Documents/Incoming
EXTERNAL_DOCUMENT_ROOT=D:/LLM_Project_data/Government_Documents/External_Official
BACKUP_ROOT=D:/LLM_Project_data/Backups/gov_ai_platform
# Retention is documented only; automatic pruning is intentionally disabled.
BACKUP_KEEP_LAST=0
POSTGRES_BACKUP_MODE=native
POSTGRES_BIN=D:/LLM_Project_data/PostgreSQL/17/pgsql/bin
POSTGRES_DATA=D:/LLM_Project_data/PostgreSQL/data17
POSTGRES_LOGS=D:/LLM_Project_data/PostgreSQL/logs
# Unset: enabled for local DEBUG runserver, disabled in CI or DJANGO_DEBUG=false.
# Explicit false disables autostart; true opts in. Never applies to other commands.
# AUTO_START_POSTGRES=true
# Podman is rollback-only; used only when POSTGRES_BACKUP_MODE=podman.
POSTGRES_CONTAINER=gr-postgres
EXTERNAL_HTTP_TIMEOUT_SECONDS=15
EXTERNAL_HTTP_MAX_BYTES=26214400
EXTERNAL_HTTP_MAX_REDIRECTS=3
EXTERNAL_HTTP_RETRY_COUNT=1
EXTERNAL_HTTP_RATE_DELAY_SECONDS=0.5
EXTERNAL_HTTP_USER_AGENT=GovAIAdministrativeAcquisition/1.0 (+local research)
DJANGO_SECRET_KEY=replace-with-a-secure-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Stage 1 identity/access deployment settings. Empty allow-lists mean queue for
# scoped IAS review; they never imply automatic approval.
ACCESS_ALLOWED_EMAIL_DOMAINS=
ACCESS_ALLOWED_ORGANIZATION_CODES=
ACCESS_ALIAS_NORMALIZATION_DOMAINS=
ACCESS_EMAIL_ALIAS_SEPARATOR=+
# CIDR networks only. X-Forwarded-For is ignored unless REMOTE_ADDR is trusted.
ACCESS_TRUSTED_PROXY_NETWORKS=
ACCESS_REQUEST_EXPIRY_DAYS=14
ACCESS_REJECTION_COOLDOWN_HOURS=72
ACCESS_ACTIVATION_TOKEN_HOURS=24
ACCESS_REQUEST_SOURCE_LIMIT=10
ACCESS_REQUEST_EMAIL_LIMIT=4
ACCESS_REQUEST_IDENTITY_LIMIT=4
ACCESS_REQUEST_WINDOW_SECONDS=3600
ACCESS_LOGIN_SOURCE_LIMIT=12
ACCESS_LOGIN_ACCOUNT_SOURCE_LIMIT=6
ACCESS_LOGIN_WINDOW_SECONDS=900
ACCESS_THROTTLE_BLOCK_SECONDS=900
DJANGO_SESSION_AGE_SECONDS=28800
DJANGO_SESSION_EXPIRE_AT_BROWSER_CLOSE=true
# Enable both only behind production HTTPS.
DJANGO_SECURE_COOKIES=false
DJANGO_SECURE_SSL_REDIRECT=false
# Development defaults to Django's console backend; production must configure
# an actual SMTP/identity channel before claiming email delivery.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
