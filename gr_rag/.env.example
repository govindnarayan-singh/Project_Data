# Your existing corpus folder. From LLM_Project_data root this can remain ./GRs
GR_ROOT=./GRs

# Local cache only. Model files are downloaded once and then reused locally.
CACHE_DIR=./.cache_local

# PostgreSQL + pgvector
DATABASE_URL=postgresql://gr_user:gr_password@localhost:5432/grdb

# Open embedding model
EMBED_MODEL=BAAI/bge-m3
EMBED_DIM=1024

# OCR executable. If tesseract is on PATH, leave this as tesseract.
# On Windows you can set an absolute path if required.
TESSERACT_CMD=tesseract
OCR_LANG=mar+eng
OCR_DPI=300

# Chunking. We deliberately keep chunks much smaller than BGE-M3's maximum context.
CHUNK_MAX_TOKENS=700
CHUNK_OVERLAP_TOKENS=100

# Embedding batch size. Reduce this if GPU/CPU RAM is limited.
EMBED_BATCH_SIZE=8
